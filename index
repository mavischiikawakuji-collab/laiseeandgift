          border-radius: 24px;
          box-shadow: 0 10px 28px rgba(58,42,30,0.06), 0 2px 8px rgba(245,193,108,0.12), inset 0 1px 0 rgba(255,255,255,0.9);
        }
        .cloud-blob{
          position: absolute;
          border-radius: 50%;
          filter: blur(32px);
          opacity: 0.9;
          animation: drift 14s ease-in-out infinite;
        }
        .gift-corner{
          position: absolute;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .gift-corner-tr{ right: 1%; top: 5%; width: 110px; height: 110px; }
        .gift-corner-bl{ left: 0.5%; bottom: 10%; width: 90px; height: 90px; }
        .gift-corner-glow{
          position: absolute;
          width: 90px; height: 90px;
          border-radius: 50%;
          background: radial-gradient(circle at 50% 50%, rgba(245,193,108,0.22) 0%, rgba(255,214,194,0.18) 38%, transparent 72%);
          filter: blur(8px);
        }
        .gift-corner-glow.bl{ background: radial-gradient(circle at 50% 50%, rgba(255,214,194,0.26) 0%, rgba(245,193,108,0.14) 42%, transparent 74%); }
        .gift-corner-img{
          width: 64px; height: 64px;
          object-fit: contain;
          position: relative;
          z-index: 1;
          filter: drop-shadow(0 6px 14px rgba(245,193,108,0.25));
          opacity: 0.92;
        }
        .gift-corner-img.small{ width: 48px; height: 48px; transform: rotate(-8deg); }
        .gift-float-img{
          position: absolute;
          width: 36px; height: 36px;
          object-fit: contain;
          opacity: 0.08;
          animation: giftFloatDrift 8.5s ease-in-out infinite;
          user-select: none;
          pointer-events: none;
        }
        @keyframes giftFloatDrift{
          0%,100%{ transform: translateY(0) rotate(0deg) }
          50%{ transform: translateY(-14px) rotate(8deg) }
        }
        .card-bounce{ animation: cardIn 0.42s cubic-bezier(0.34,1.56,0.64,1) both; }
        .confetti-piece{
          position: absolute;
          top: -20px;
          animation-name: fall;
          animation-timing-function: cubic-bezier(0.25,0.46,0.45,0.94);
          animation-fill-mode: forwards;
          will-change: transform, opacity;
        }
        .scrollbar-none::-webkit-scrollbar{display:none}
        .scrollbar-none{ -ms-overflow-style:none; scrollbar-width:none; }
        @keyframes drift{
          0%,100%{ transform: translateY(0) scale(1) }
          50%{ transform: translateY(-12px) scale(1.02) }
        }
        @keyframes cardIn{
          from{ transform: translateY(14px) scale(0.98); opacity:0 }
          to{ transform: translateY(0) scale(1); opacity:1 }
        }
        @keyframes pop{
          from{ transform: translateY(20px) scale(0.96); opacity:0 }
          to{ transform: translateY(0) scale(1); opacity:1 }
        }
        @keyframes toast{
          from{ transform: translate(-50%, 18px) scale(0.96); opacity:0 }
          to{ transform: translate(-50%, 0) scale(1); opacity:1 }
        }
        @keyframes fall{
          0%{ transform: translate3d(0,-10px,0) rotate(0deg) scale(1); opacity:0 }
          10%{ opacity:1 }
          80%{ opacity:1 }
          100%{ transform: translate3d(18px,110vh,0) rotate(360deg) scale(0.9); opacity:0 }
        }
        @keyframes float{ 0%,100%{ transform: translateY(0) } 50%{ transform: translateY(-6px) } }
        .animate-float{ animation: float 3s ease-in-out infinite }
        .animate-bounce-slow{ animation: float 2.2s ease-in-out infinite }
        input, select, textarea{ -webkit-appearance:none; appearance:none; }
