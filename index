        @import url('https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@700;800;900&family=Kiwi+Maru:wght@500;700&family=Noto+Serif+TC:wght@600;700;800&family=Noto+Sans+HK:wght@400;500;700&display=swap');
        :root{
          --bg: #FFF9F0;
          --peach: #FFD6C2;
          --gold: #F5C16C;
          --gold-border: rgba(245,193,108,0.42);
          --vermillion: #E85D5D;
          --ink: #3A2A1E;
          --ink-2: #9A8A7A;
          --safe-area-inset-top: env(safe-area-inset-top, 0px);
          --font-serif: "Noto Serif TC", "Songti SC", "Noto Serif", serif;
          --font-sans: "Noto Sans HK", ui-rounded, system-ui, -apple-system, sans-serif;
          --font-cute: "Zen Maru Gothic", "Kiwi Maru", "Noto Sans TC", "PingFang HK", sans-serif;
        }
        *{ font-family: var(--font-sans); }
        .cute-title{
          font-family: var(--font-cute);
          font-weight: 800;
          letter-spacing: 1px;
          font-size: clamp(32px, 8vw, 44px);
          line-height: 1.1;
          color: var(--ink);
          text-shadow:
            0 0 0 #fff,
            2px 0 0 #FFFEFB,
            -2px 0 0 #FFFEFB,
            0 2px 0 #FFFEFB,
            0 -2px 0 #FFFEFB,
            2px 2px 0 #FFFEFB,
            -2px -2px 0 #FFFEFB,
            3px 0 0 rgba(245,193,108,0.85),
            -3px 0 0 rgba(245,193,108,0.6),
            0 4px 12px rgba(245,193,108,0.28);
          animation: cuteBounce 3.2s ease-in-out infinite;
          display: inline-block;
          transform-origin: center bottom;
          position: relative;
          padding: 0 4px;
        }
        @keyframes cuteBounce{
          0%,100%{ transform: translateY(0) scale(1) }
          18%{ transform: translateY(-3px) scale(1.02,0.98) }
          36%{ transform: translateY(0) scale(0.99,1.01) }
          54%{ transform: translateY(-1.5px) scale(1.01) }
        }
        .wavy-underline{
          width: 200px;
          height: 12px;
          position: relative;
          overflow: visible;
        }
        .wavy-underline span{
          position: absolute;
          left: 0; right: 0; top: 0;
          height: 100%;
          background: url("data:image/svg+xml,%3Csvg width='200' height='12' viewBox='0 0 200 12' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 8 Q 12 0 24 8 T 48 8 T 72 8 T 96 8 T 120 8 T 144 8 T 168 8 T 200 8' stroke='%23F5C16C' stroke-width='2.5' fill='none' stroke-linecap='round'/%3E%3C/svg%3E") repeat-x;
          opacity: 0.85;
          animation: waveDrift 4s linear infinite;
        }
        @keyframes waveDrift{
          from{ background-position: 0 0 }
          to{ background-position: 48px 0 }
        }
        .animate-bounce-soft{ animation: softBounce 3s ease-in-out infinite; }
        @keyframes softBounce{
          0%,100%{ transform: translateY(0) scale(1) }
          50%{ transform: translateY(-6px) scale(1.04) }
        }
        .glass-card{
          background: linear-gradient(180deg, rgba(255,255,254,0.92) 0%, rgba(255,249,240,0.78) 100%);
          backdrop-filter: blur(18px) saturate(1.25);
          -webkit-backdrop-filter: blur(18px) saturate(1.25);
          border: 1px solid var(--gold-border);
          border-radius: 24px;
          box-shadow: 0 10px 28px rgba(58,42,30,0.06), 0 2px 8px rgba(245,193,108,0.12), inset 0 1px 0 rgba(255,255,255,0.9);
        }
        .cloud-blob{
          position: absolute;
          border-radius: 50%;
          filter: blur(32px);
          opacity: 0.9;
          animation: drift 14s ease-in-out infinite;
        }
        .gift-corner{
          position: absolute;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .gift-corner-tr{ right: 1%; top: 5%; width: 110px; height: 110px; }
        .gift-corner-bl{ left: 0.5%; bottom: 10%; width: 90px; height: 90px; }
        .gift-corner-glow{
          position: absolute;
          width: 90px; height: 90px;
          border-radius: 50%;
          background: radial-gradient(circle at 50% 50%, rgba(245,193,108,0.22) 0%, rgba(255,214,194,0.18) 38%, transparent 72%);
          filter: blur(8px);
        }
        .gift-corner-glow.bl{ background: radial-gradient(circle at 50% 50%, rgba(255,214,194,0.26) 0%, rgba(245,193,108,0.14) 42%, transparent 74%); }
        .gift-corner-img{
          width: 64px; height: 64px;
          object-fit: contain;
          position: relative;
          z-index: 1;
          filter: drop-shadow(0 6px 14px rgba(245,193,108,0.25));
          opacity: 0.92;
        }
        .gift-corner-img.small{ width: 48px; height: 48px; transform: rotate(-8deg); }
        .gift-float-img{
          position: absolute;
          width: 36px; height: 36px;
          object-fit: contain;
          opacity: 0.08;
          animation: giftFloatDrift 8.5s ease-in-out infinite;
          user-select: none;
          pointer-events: none;
        }
        @keyframes giftFloatDrift{
          0%,100%{ transform: translateY(0) rotate(0deg) }
